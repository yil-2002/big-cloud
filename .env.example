# ===========================================================================
# hugecloud — Telegram Cloud Bot + FastAPI + Mini App
#
# Nusxalang:   cp .env.example .env      (keyin qiymatlarni to'ldiring)
# Yuklanishi:  python-dotenv orqali, ilova ishga tushganda.
#
# ⚠️  .env faylini Git'ga qo'shmang (.gitignore'da bor). Har bir qiymatning
#     yonida "sukut" ko'rsatilgan — ko'pini o'zgartirmasa ham bo'ladi.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) ISHGA TUSHIRISH REJIMI
# ---------------------------------------------------------------------------
# all     = bot (polling) + HTTP API + Mini App bitta jarayonda  ← tavsiya
# bot     = faqat Telegram boti
# api     = faqat HTTP API (Render "web service" uchun)
# migrate = faqat sxema migratsiyasi va chiqish
RUN_MODE=all

# ---------------------------------------------------------------------------
# 2) TELEGRAM BOT (majburiy)
# ---------------------------------------------------------------------------
# @BotFather dan olingan token. Bo'sh bo'lsa ilova ishga tushmaydi.
BOT_TOKEN=123456789:AAH-your-bot-token-here
# Inline rejim va deep-link'lar uchun botning @username'i
BOT_USERNAME=Huge_cloud_bot
# Matn formati (HTML tavsiya etiladi — matnlar <b> teglarini ishlatadi)
BOT_PARSE_MODE=HTML
# Long-polling kutilishi (soniya)
BOT_POLLING_TIMEOUT=30
# Ishga tushganda eski update'larni tashlab yuborish (restart'da takrorlanmasin)
BOT_DROP_PENDING_UPDATES=true

# ---------------------------------------------------------------------------
# 3) ADMINISTRATOR (👑 /diyor paneli)
# ---------------------------------------------------------------------------
# Asosiy admin Telegram ID'si (bir nechta bo'lsa vergul bilan ADMIN_IDS).
# Shu ID har doim barcha funksiyalarni ochadi (hatto AUTH_REQUIRED=true bo'lsa ham).
ADMIN_ID=111222333
ADMIN_IDS=
# /diyor panelini ochish uchun qo'shimcha parol (bo'sh = faqat ADMIN_ID yetarli)
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 4) SHAXSIY ARXIV KANALI (🛡️ fayl barqarorligi)
# ---------------------------------------------------------------------------
# Har bir yuklama shu kanarga avtomatik nusxalanadi; kanal message_id va
# file_id bazada saqlanadi. Foydalanuvchi asl xabarni o'chirsa ham fayl qoladi.
# Bot kanalda ADMIN bo'lishi va "xabar yuborish" huquqi bo'lishi shart.
# Format: -100xxxxxxxxxx (yoki @kanal_nomi). Bo'sh = arxiv o'chirilgan.
ARCHIVE_CHANNEL_ID=-1001234567890
# Umumiy yoqish/o'chirish tugmasi
ARCHIVE_ENABLED=true
# false = arxivlash fon rejimida (foydalanuvchi tasdiqni darhol ko'radi) ← tavsiya
# true  = arxiv tugaguncha kutish (sekinroq, lekin xato darhol ko'rinadi)
ARCHIVE_BLOCKING=false
# Kanal javob bermasa necha marta urinish
ARCHIVE_MAX_ATTEMPTS=3
# Urinishlar orasidagi pauza (soniya)
ARCHIVE_RETRY_DELAY=2.0
# Arxiv nusxasiga yoziladigan izoh prefiksi (audit uchun)
ARCHIVE_CAPTION_PREFIX=☁️ ARCHIVE

# ---------------------------------------------------------------------------
# 5) AUTENTIFIKATSIYA (🔐 hisob: login + parol)
# ---------------------------------------------------------------------------
# true = hisobini tasdiqlamagan foydalanuvchi bulut funksiyalarini ochmaydi
#        (faqat /start, /login, /register, /help, /cancel ishlaydi)
AUTH_REQUIRED=true
# true = /register bilan yangi hisob ochish mumkin
AUTH_ALLOW_REGISTER=true
# Login katta-kichik harfga sezgir bo'lsinmi (false = "Ali" == "ali")
AUTH_CASE_SENSITIVE=false
# Parol uzunligi chegaralari
AUTH_MIN_PASSWORD=6
AUTH_MAX_PASSWORD=128
# Noto'g'ri parol urinishlari soni (shundan keyin hisob vaqtincha qulflanadi)
AUTH_MAX_ATTEMPTS=5
# Qulflash muddati (soniya; 300 = 5 daqiqa)
AUTH_LOCKOUT=300
# Sessiyani eslab qolish (is_authenticated bazada saqlanadi)
AUTH_REMEMBER=true

# ---------------------------------------------------------------------------
# 6) SAQLASH (☁️ kvota va fayllar)
# ---------------------------------------------------------------------------
# 0 = CHEKSIZ (Unlimited) ← sukut. Boshqa qiymat baytlarda (5368709120 = 5 GB).
STORAGE_QUOTA=0
# Adminlar uchun kvota (0 = cheksiz)
ADMIN_QUOTA=0
# Kvota 0 bo'lganda UI'da ko'rinadigan matn
QUOTA_UNLIMITED_LABEL=Cheksiz (Unlimited)
# Bitta faylning maksimal hajmi (bayt). 2 GiB = Telegram Bot API chegarasi.
STORAGE_MAX_FILE_SIZE=2147483648
# Bir xil file_unique_id ikkinchi marta yuklansa — yangi fayl yaratilmaydi
STORAGE_DEDUPE=true
# Ro'yxat sahifasidagi fayllar soni (legacy mexanika: 5 ta)
PAGE_SIZE=5
# Fayllarni ko'rishda haqiqiy mediani yuborish (legacy "browse as media")
BROWSE_SEND_MEDIA=true
# Yangi fayllar sukut bo'yicha ochiq (public) bo'lsinmi
STORAGE_DEFAULT_PUBLIC=false
# Ulashish havolasi amal qilish muddati (soniya; 604800 = 7 kun)
SHARE_LINK_TTL=604800
# Inline rejimda qaytariladigan natijalar soni
INLINE_RESULTS_LIMIT=20
# Media stream proxy (Range support bilan; token foydalanuvchiga ko'rinmaydi)
STREAM_PROXY_ENABLED=true
# 20 MB devori: rasmiy Bot API getFile faqat ~20 MB gacha fayl beradi.
# Undan katta fayl uchun /stream 413 (file_too_large_for_stream) qaytaradi va
# Mini App "Telegram'da ochish" tugmasini ko'rsatadi. 0 = devor o'chirilgan
# (masalan, LOCAL_BOT_API ishlatilganda).
STREAM_MAX_SIZE=20971520
# O'zingizning Bot API serveringiz bo'lsa (ixtiyoriy)
LOCAL_BOT_API=

# ---------------------------------------------------------------------------
# 7) LEGACY UMUMIY PAROL DARVOZASI (ixtiyoriy)
# ---------------------------------------------------------------------------
# Bu **butun bot** uchun bitta umumiy parol (eski mexanika). Bo'sh = o'chirilgan.
# Per-user hisoblar uchun yuqoridagi AUTH_* dan foydalaning.
BOT_PASSWORD=
BOT_REQUIRE_PASSWORD=false
BOT_PASSWORD_ATTEMPTS=5
BOT_PASSWORD_COOLDOWN=60

# ---------------------------------------------------------------------------
# 8) MA'LUMOTLAR BAZASI
# ---------------------------------------------------------------------------
# Production (PostgreSQL):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/hugecloud
# Lokal/test (SQLite):
#   DATABASE_URL=sqlite+aiosqlite:///./data/hugecloud.sqlite3
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloud_bot
# SQL so'rovlarini logga chiqarish (faqat debug uchun!)
DB_ECHO=false
# Ishga tushganda yetishmayotgan jadvallarni yaratish
DB_AUTO_CREATE=true
# Ishga tushganda yetishmayotgan USTUNLARNI qo'shish (ma'lumot o'chmaydi)
DB_AUTO_MIGRATE=true
# Ulanishlar havzasi (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# --- SQLite pragmalari (faqat SQLite ishlatilsa; PostgreSQL'da e'tiborsiz) ---
# WAL: bot va API bir vaqtda yozganda "database is locked" xatolarini kamaytiradi.
# DIQQAT: baza NFS/SMB tarmoq diskida bo'lsa WAL ishonchsiz -> DELETE qo'ying.
DB_JOURNAL_MODE=WAL
# Yozuv qulfini kutish (ms). 0 = darhol SQLITE_BUSY.
DB_BUSY_TIMEOUT=5000
# WAL bilan NORMAL xavfsiz va tezroq (FULL har commit'da disk sinxronini talab qiladi).
DB_SYNCHRONOUS=NORMAL

# ---------------------------------------------------------------------------
# 9) KESH / REDIS (ixtiyoriy, lekin tavsiya etiladi)
# ---------------------------------------------------------------------------
# Redis bo'lmasa avtomatik xotira (in-memory) keshiga o'tadi — ishlaydi,
# lekin bir necha jarayon bo'lsa umumiy kesh uchun Redis kerak.
REDIS_URL=redis://localhost:6379/0
# true = Redis bo'lmasa ishga tushmaslik (production uchun)
REDIS_REQUIRED=false
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=3.0
REDIS_SOCKET_CONNECT_TIMEOUT=3.0
REDIS_KEY_PREFIX=cloudbot
# Kesh muddatlari (soniya)
CACHE_TTL_USER=600
CACHE_TTL_FILE=300
CACHE_TTL_SEARCH=60
CACHE_TTL_TG_PATH=3000
CACHE_TTL_STREAM_TOKEN=300

# ---------------------------------------------------------------------------
# 10) HTTP API + MINI APP
# ---------------------------------------------------------------------------
# Server qaysi manzilda tinglaydi (konteyner/PaaS uchun 0.0.0.0 shart)
API_HOST=0.0.0.0
# Port. PaaS (Render/Heroku/Fly) PORT ni o'zi beradi — shu nom ishlatiladi.
PORT=8000
API_PREFIX=/api/v1
# Interaktiv hujjatlar: /docs (Swagger) va /redoc
API_DOCS_ENABLED=true
# Mini App statik fayllarini serve qilish
SERVE_WEB=true
WEB_STATIC_DIR=web
# Mini App qaysi yo'lda ochiladi ("/" = ildizda)
WEB_MOUNT_PATH=/
# Mini App'ning tashqi URL'i (bo'sh = BASE_URL + WEB_MOUNT_PATH)
WEB_APP_URL=
# Har startup'da setChatMenuButton chaqiriladi (restart = menyu tugmasi yangilanadi).
WEB_SET_MENU_BUTTON=true
# Menyu tugmasi matni (1-64 belgi).
WEB_MENU_BUTTON_TEXT=☁️ Bulut
# CORS (vergul bilan; "*" = hammasi). Production'da aniq domen bering.
CORS_ORIGINS=*
# Bitta so'rovning maksimal davomiyligi (soniya)
API_REQUEST_TIMEOUT=30

# --- Webhook rejimi (polling o'rniga) --------------------------------------
# PaaS'da (Render) faqat bitta HTTP port bo'lsa: WEBHOOK_ENABLED=true qilib,
# Telegram update'larini shu portga qabul qilasiz.
WEBHOOK_ENABLED=false
# Tashqi (HTTPS) manzil, masalan: https://hugecloud.onrender.com
WEBHOOK_URL=
WEBHOOK_PATH=/api/webhook
# Telegram'ga beriladigan maxfiy token (so'rovlar haqiqiyligini tekshiradi)
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 11) XAVFSIZLIK (tokenlar va limitlar)
# ---------------------------------------------------------------------------
# JWT imzo kaliti. BO'SH qoldirilsa BOT_TOKEN dan avtomatik hosil qilinadi
# (shuning uchun hech qachon "hammaga ma'lum" sukut kalit ishlatilmaydi).
# Bir necha servis bitta sessiya bazasini bo'lishsa — aniq qiymat bering (≥48 belgi).
JWT_SECRET=
JWT_ALGORITHM=HS256
# Sessiya tokeni muddati (soniya; 86400 = 24 soat)
ACCESS_TOKEN_TTL=86400
# Mini App initData qancha vaqt amal qiladi (replay himoyasi)
INIT_DATA_MAX_AGE=86400
# initData'ni IP manzilga bog'lash (proksi ortida bo'lsa false qoldiring)
INIT_DATA_BIND_IP=false
# Umumiy limitlash tugmasi
RATE_LIMIT_ENABLED=true
# HTTP API: so'rov/deraza (soniya)
API_RATE_LIMIT=60
API_RATE_WINDOW=60
# Bot xabarlari
BOT_RATE_LIMIT=20
BOT_RATE_WINDOW=60
# Tugma bosishlari (callback flood himoyasi)
CALLBACK_RATE_LIMIT=30
CALLBACK_RATE_WINDOW=60
# Inline so'rovlar (har bosishda DB'ga boradi — qattiqroq)
INLINE_RATE_LIMIT=30
INLINE_RATE_WINDOW=10
# Media stream/yuklab olish (eng qimmat operatsiya)
DOWNLOAD_RATE_LIMIT=20
DOWNLOAD_RATE_WINDOW=60
# /stream chegarasi (bandwidth-DoS himoyasi; pleer seek'lari uchun keng)
STREAM_RATE_LIMIT=120
STREAM_RATE_WINDOW=60
# Ulashish tokenlari entropiyasi (bayt)
SHARE_TOKEN_ENTROPY=24

# ---------------------------------------------------------------------------
# 12) ILOVA / LOG
# ---------------------------------------------------------------------------
APP_NAME=Telegram Cloud Drive
APP_VERSION=2.0.0
# development | production | staging
APP_ENV=development
APP_DEBUG=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
APP_TIMEZONE=UTC
# uz = o'zbekcha interfeys; en = inglizcha
APP_LANGUAGE=uz
# Tashqi (ommaviy) base URL — Mini App havolalari va webhook uchun
BASE_URL=http://localhost:8000
